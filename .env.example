# ============================================================================
# DELTA ERP ENTERPRISE — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ============================================================================

# Ambiente (development | staging | production)
NODE_ENV=development

# API Backend (NestJS)
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Portais Frontend (Vite)
VITE_INTERNAL_PORTAL_PORT=5173
VITE_EXTERNAL_PORTAL_PORT=5174
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Banco de Dados Principal (PostgreSQL 16)
DATABASE_URL="postgresql://delta_admin:delta_secret_2026@localhost:5432/delta_erp?schema=public"

# Cache e Filas (Redis / BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=delta_redis_secret

# Segurança, JWT e MFA
JWT_ACCESS_SECRET="replace-with-64-byte-hex-secret-in-production"
JWT_REFRESH_SECRET="replace-with-64-byte-hex-refresh-secret-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
MFA_ISSUER="DELTA_ERP_ENTERPRISE"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage S3 Compatível (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=delta_storage_admin
S3_SECRET_KEY=delta_storage_secret
S3_BUCKET_DOCUMENTS=delta-erp-documents
S3_BUCKET_FISCAL=delta-erp-fiscal-xml
