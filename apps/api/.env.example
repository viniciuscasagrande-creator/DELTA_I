# ============================================================================
# ENTERPRISE ERP — apps/api/.env.example
# ============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Opção 1: PostgreSQL Cloud (Neon) ou Local/Docker
DATABASE_URL="postgresql://delta_admin:delta_secret_2026@localhost:5432/delta_erp?schema=public"

# Cache e Filas
REDIS_HOST=localhost
REDIS_PORT=6379

# Segurança
JWT_ACCESS_SECRET="replace-with-secure-secret"
JWT_REFRESH_SECRET="replace-with-secure-refresh-secret"
MFA_ISSUER="ENTERPRISE_ERP"
