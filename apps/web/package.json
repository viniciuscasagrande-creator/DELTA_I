{
  "name": "@delta-erp/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma || echo 'Skipping prisma generate'",
    "dev": "vite --port 5173",
    "build": "vite build && node -e \"const fs=require('fs');fs.cpSync('dist','apps/web/dist',{recursive:true})\"",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^16.4.5",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
